<?xml version="1.0" encoding="utf-8"?>
<!-- Macrobenchmark and the Baseline Profile generator need a profileable, non-debuggable target (API 29+). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <profileable
            android:shell="true"
            tools:targetApi="q" />
    </application>
</manifest>
